<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="#212121">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="48dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Target Display"
        android:textColor="#BBBBBB"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"/>

    <Spinner
        android:id="@+id/dialog_display_spinner"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="48dp"
        android:backgroundTint="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sensitivity"
        android:textColor="#BBBBBB"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"/>

    <SeekBar
        android:id="@+id/dialog_sensitivity_seekbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:max="100"
        android:layout_marginBottom="32dp" />

    <Switch
        android:id="@+id/dialog_acceleration_switch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/setting_acceleration"
        android:textColor="#BBBBBB"
        android:textSize="16sp" />

    <Switch
        android:id="@+id/dialog_reverse_scroll_switch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:text="@string/setting_reverse_scroll"
        android:textColor="#BBBBBB"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btn_close_settings"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Close"
        android:textColor="#FFFFFF" />

</LinearLayout>
